**/__pycache__/
*.py[cod]
*$py.class
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Local storage and uploaded test files
storage/uploads/*
!storage/uploads/.gitkeep
backend/storage/uploads/*
