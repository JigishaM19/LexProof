!*.env.example

# Private keys, certificates and token configs
*.pem
*.key
*.cert
*.crt
serviceAccountKey*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Node dependencies and Next.js build output
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.vercel/
**/.vercel/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python virtual environments, caches and bytecode
