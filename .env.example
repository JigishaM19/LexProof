# ==============================================================================
# LexProof Environment Configuration Template
# Copy this file to backend/.env and frontend/.env.local and populate with your credentials.
# Do NOT put production secrets in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Security & Authentication (JWT Signing & Argon2id)
SECRET_KEY=change-this-in-production-generate-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=lexproof_db

# Temporary Data & Rate Limiting (Redis / Upstash - Optional)
REDIS_URL=redis://localhost:6379

# Email Delivery (Option 1: Gmail / SMTP - Free to any email, No custom domain needed)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_FROM_NAME="LexProof Verification"
SMTP_USE_TLS=true

# Email Delivery (Option 2: Resend - Requires verified custom domain for external recipients)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME="LexProof Verification"

# SMS Delivery Service (Optional: Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_phone_number

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:3000/dashboard

# AI & Document Intelligence (Google Gemini / Vision OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Official DigiLocker / API Setu (When authorized credentials available)
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/v1/verification/digilocker/callback

# Storage Configuration
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
